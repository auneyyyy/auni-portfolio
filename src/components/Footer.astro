---
import Icon from './Icon.astro';
import { profile, links } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p class="big" aria-hidden="true">{profile.shortName}<span>.</span></p>
    <div class="row">
      <p>© {year} {profile.name}. Made with care in Pulau Pinang.</p>
      <ul class="links">
        <li><a href={`mailto:${links.email}`}>Email</a></li>
        <li><a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href={links.github} target="_blank" rel="noopener">GitHub</a></li>
        <li>
          <a href="#top" class="top">Back to top <Icon name="arrowUp" size={16} /></a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--text);
    color: var(--bg);
    padding: 56px 0 32px;
    overflow: hidden;
  }
  .big {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 15vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    opacity: 0.95;
  }
  .big span {
    color: var(--coral);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    padding-top: 24px;
    border-top: 2px solid color-mix(in srgb, var(--bg) 25%, transparent);
  }
  .row p {
    margin: 0;
    font-size: 0.95rem;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: none;
    padding: 4px 0;
    background: linear-gradient(var(--sun), var(--sun)) left bottom / 0 2px no-repeat;
    transition: background-size 0.25s var(--ease);
  }
  .links a:hover {
    background-size: 100% 2px;
  }
</style>
