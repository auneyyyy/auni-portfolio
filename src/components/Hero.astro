---
import Icon from './Icon.astro';
import { profile, links, skills } from '../data/portfolio';

const marquee = skills.flatMap((g) => g.items);
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Decorative background shapes -->
  <div class="shapes" aria-hidden="true">
    <span class="shape s1"></span>
    <span class="shape s2"></span>
    <span class="shape s3"><Icon name="sparkle" size={64} /></span>
  </div>

  <div class="container hero-grid">
    <div class="copy">
      {profile.availableForWork && (
        <p class="status" data-reveal>
          <span class="dot" aria-hidden="true"></span> Open to new opportunities
        </p>
      )}

      <h1 id="hero-title" data-reveal style="--delay: 80ms">
        <span class="hi">Hi, I'm</span>
        <span class="name">{profile.shortName}<span class="period" aria-hidden="true">.</span></span>
      </h1>

      <p class="role" data-reveal style="--delay: 160ms">
        <span class="role-pill">{profile.role}</span>
      </p>

      <p class="tagline" data-reveal style="--delay: 220ms">{profile.tagline}</p>

      <div class="ctas" data-reveal style="--delay: 300ms">
        <a class="btn btn--coral" href="#projects">
          See my work <Icon name="arrowRight" />
        </a>
        <a class="btn btn--plain" href="#contact">Get in touch</a>
        {links.resume ? (
          <a class="btn btn--plain" href={links.resume} target="_blank" rel="noopener">
            <Icon name="file" /> Resume
          </a>
        ) : (
          <span class="btn btn--plain" aria-disabled="true" title="Resume coming soon">
            <Icon name="file" /> Resume (coming soon)
          </span>
        )}
      </div>
    </div>

    <div class="card-wrap" data-reveal style="--delay: 200ms">
      <div class="id-card">
        <div class="id-top">
          <span class="id-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="id-label">hello.fig</span>
        </div>
        <div class="avatar">
          {profile.photo ? (
            <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="320" height="320" />
          ) : (
            <span class="initials" aria-hidden="true">{profile.initials}</span>
          )}
        </div>
        <p class="id-name">{profile.name}</p>
        <p class="id-loc"><Icon name="pin" size={16} /> {profile.location}</p>
      </div>
      <span class="sticker sticker-a" aria-hidden="true">UI ✦ UX</span>
      <span class="sticker sticker-b" aria-hidden="true">&lt;code/&gt;</span>
    </div>
  </div>

  <!-- Decorative skills ticker (the real list is in the Skills section) -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <ul>
          {marquee.map((s) => (
            <li>{s}<Icon name="sparkle" size={14} /></li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(40px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: 56px;
    align-items: center;
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border: var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #1fbf75;
    box-shadow: 0 0 0 0 rgba(31, 191, 117, 0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 10px rgba(31, 191, 117, 0); }
    100% { box-shadow: 0 0 0 0 rgba(31, 191, 117, 0); }
  }

  h1 {
    margin-top: 18px;
    font-weight: 800;
  }
  .hi {
    display: block;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .name {
    display: block;
    font-size: clamp(3.4rem, 13vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .period {
    color: var(--coral);
  }

  .role {
    margin: 22px 0 0;
  }
  .role-pill {
    display: inline-block;
    padding: 8px 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    background: var(--violet);
    color: var(--on-accent);
    border: var(--border);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--shadow-c);
    transform: rotate(-1.5deg);
  }

  .tagline {
    max-width: 34ch;
    margin: 26px 0 32px;
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
    color: var(--muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ID card */
  .card-wrap {
    position: relative;
    justify-self: center;
    width: min(100%, 360px);
  }
  .id-card {
    position: relative;
    padding: 16px 16px 22px;
    background: var(--surface);
    border: var(--border);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
    transform: rotate(2.5deg);
    transition: transform 0.5s var(--ease);
  }
  .card-wrap:hover .id-card {
    transform: rotate(0deg) translateY(-4px);
  }
  .id-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .id-dots {
    display: flex;
    gap: 6px;
  }
  .id-dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: var(--coral);
  }
  .id-dots i:nth-child(2) { background: var(--sun); }
  .id-dots i:nth-child(3) { background: var(--mint); }
  .id-label {
    font: 600 0.8rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--muted);
  }
  .avatar {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: var(--border);
    border-radius: 18px;
    background:
      radial-gradient(circle at 30% 25%, var(--sun) 0 22%, transparent 23%),
      radial-gradient(circle at 78% 80%, var(--mint) 0 26%, transparent 27%),
      var(--coral);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 22vw, 8rem);
    color: var(--on-accent);
    letter-spacing: -0.05em;
  }
  .id-name {
    margin: 16px 0 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.25;
  }
  .id-loc {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--muted);
    font-weight: 500;
  }

  .sticker {
    position: absolute;
    padding: 6px 14px;
    font-family: var(--font-display);
    font-weight: 800;
    border: var(--border);
    border-radius: 999px;
    color: var(--on-accent);
    box-shadow: 3px 3px 0 var(--shadow-c);
    animation: bob 5s ease-in-out infinite;
  }
  .sticker-a {
    top: -14px;
    left: -18px;
    background: var(--sun);
    transform: rotate(-10deg);
  }
  .sticker-b {
    bottom: 70px;
    right: -22px;
    background: var(--mint);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    transform: rotate(8deg);
    animation-delay: -2.5s;
  }
  @media (max-width: 480px) {
    .sticker-a { left: -6px; }
    .sticker-b { right: -6px; }
  }
  @keyframes bob {
    50% { translate: 0 -8px; }
  }

  /* Background shapes */
  .shapes .shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  .s1 {
    width: 380px;
    height: 380px;
    top: -140px;
    right: -120px;
    border-radius: 50%;
    background: var(--sun);
    opacity: 0.35;
    filter: blur(2px);
  }
  .s2 {
    width: 220px;
    height: 220px;
    bottom: 120px;
    left: -110px;
    border-radius: 40px;
    background: var(--violet);
    opacity: 0.3;
    transform: rotate(18deg);
  }
  .s3 {
    top: 46%;
    left: 52%;
    color: var(--coral);
    opacity: 0.8;
    animation: spin 18s linear infinite;
  }
  @media (max-width: 899px) {
    .s3 { display: none; }
  }
  @keyframes spin {
    to { rotate: 360deg; }
  }
  .hero-grid > * {
    position: relative;
    z-index: 1;
  }

  /* Marquee */
  .marquee {
    position: relative;
    z-index: 1;
    border-block: var(--border);
    background: var(--text);
    color: var(--bg);
    overflow: hidden;
    transform: rotate(-1.2deg);
    margin: 0 -20px 24px;
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .track ul {
    display: flex;
    margin: 0;
    padding: 14px 0;
    list-style: none;
  }
  .track li {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding-right: 24px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    white-space: nowrap;
  }
  .track li :global(svg) {
    color: var(--sun);
  }
  @keyframes scroll {
    to { transform: translateX(-50%); }
  }
</style>
